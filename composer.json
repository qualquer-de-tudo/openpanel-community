{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "qualquer-de-tudo/openpanel-community",
    "type": "library",
    "description": "Versioned Linux hosting control panel module for Laravel",
    "keywords": [
        "laravel",
        "control-panel",
        "hosting",
        "qopenpanel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/framework": "^13.17",
        "laravel/mcp": "~1.1.2",
        "ext-zip": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "orchestra/testbench": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "QOpenPanel\\Community\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "templates:check": "@php vendor/bin/testbench panel:templates-check",
        "templates:lock": "@php vendor/bin/testbench panel:templates-lock"
    },
    "extra": {
        "laravel": {
            "providers": [
                "QOpenPanel\\Community\\Providers\\QOpenPanelServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/node_modules",
            "/vendor",
            "/storage",
            "/.env",
            "/phpunit.xml",
            "/composer.lock",
            "/dist-demo"
        ]
    }
}
