{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:package",
        "build:demo": "vite build --config vite.demo.config.js && node demo/finalize.mjs",
        "preview:demo": "vite preview --config vite.demo.config.js --host 127.0.0.1",
        "translations:check": "node bin/translations.mjs check",
        "translations:add": "node bin/translations.mjs add",
        "translations:sync": "node bin/translations.mjs sync",
        "translations:status": "node bin/translations.mjs status",
        "test:i18n": "node --test tests/Unit/i18n.test.mjs",
        "templates:new": "node bin/template-new.mjs",
        "templates:lock": "composer templates:lock",
        "templates:check": "composer templates:check",
        "build:package": "vite build --config vite.package.config.js"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.2.1",
        "prettier": "^3.9.10",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "lucide-react": "^1.67.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
